# Settings for docker compose: copy this file to .env (next to docker-compose.yml).
# The app's own settings (LLM, JWT secret, email, admins) go in backend/.env.

# Password for the PostgreSQL container. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# Your domain, e.g. apsit-chat.duckdns.org: Caddy then gets a free HTTPS certificate automatically
# (ports 80 and 443 must be open). ":80" serves plain HTTP on any address, for a first test.
SITE_ADDRESS=:80

# Optional
# BACKUP_KEEP_DAYS=14
# ENABLE_DOCS=false
# HTTP_PORT=80
# HTTPS_PORT=443
