# Copy this file to backend/.env and fill in the values. Never commit backend/.env.

# PostgreSQL (async driver)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/college_ai

# Groq LLM (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Auth (generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ADMIN_EMAIL=

# Only these email domains can sign up (comma-separated). Leave empty to allow any email.
ALLOWED_SIGNUP_DOMAINS=apsit.edu.in

# Frontend URLs allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email used to send OTPs. For Gmail, MAIL_PASSWORD is an App Password
# (https://myaccount.google.com/apppasswords), not your normal Gmail password.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_TLS=True
MAIL_SSL=False
